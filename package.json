{
	"name": "n8n-nodes-shab",
	"version": "0.1.0",
	"description": "Read the Swiss Official Gazette of Commerce (SHAB) from n8n: commercial-register publications with event classification, and a polling trigger",
	"license": "MIT",
	"homepage": "https://prospex.ch",
	"keywords": [
		"n8n-community-node-package",
		"shab",
		"sogc",
		"fosc",
		"switzerland",
		"commercial-register",
		"handelsregister"
	],
	"author": {
		"name": "Prospex",
		"email": "hello@prospex.ch",
		"url": "https://prospex.ch"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prospex-ch/n8n-nodes-shab.git"
	},
	"bugs": {
		"url": "https://github.com/prospex-ch/n8n-nodes-shab/issues"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test --experimental-strip-types test/*.test.ts",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"nodes": [
			"dist/nodes/Shab/Shab.node.js",
			"dist/nodes/Shab/ShabTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.23.0",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
